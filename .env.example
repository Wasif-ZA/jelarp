# Supabase: Project Settings, API. Server-only, never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Required once SUPABASE_URL is set, locally too. Any long random string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Twitch logins that get Studio and the wheel, comma separated, lowercase.
CREATOR_LOGINS=

# Client ID from https://dev.twitch.tv/console/apps
# OAuth Redirect URLs: http://localhost:3000/ and the live site URL, both with a trailing slash.
NEXT_PUBLIC_TWITCH_CLIENT_ID=

# Client Secret from the same Twitch app. Server-only.
# Without it the site still runs; the live dots on the who-else list just stay off.
TWITCH_CLIENT_SECRET=

# 1 only for a no-backend demo: the site runs and saves in each visitor's browser. Remove to go live.
NEXT_PUBLIC_DEMO=
